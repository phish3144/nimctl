  [update_sum_ok]="Prüfsumme stimmt" [update_sum_bad]="Prüfsumme stimmt nicht – Download verworfen" [update_sum_none]="keine SHA256SUMS auf GitHub – Prüfsumme nicht verifiziert" [update_changes]="Änderungen:"
)
T_en+=(
