  if has python3; then
    NIMCTL_WEBUI_DB="$db" NIMCTL_SEARXNG_URL="$url" NIMCTL_SEARCH_RESULTS="$nres" NIMCTL_SEARCH_CONCURRENT="$nconc" python3 - <<'PY' 2>/dev/null || true
import json, os, sqlite3, time
