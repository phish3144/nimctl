dash_register() { DASH_FN[$1]="$2"; DASH_LABEL[$1]="$3"; DASH_GROUP[$1]="${4:-use}"; }
PANEL_LINES=8
PAUSE_KEYS=" a f t 1 2 3 4 d l e g n b ? "

svc_row() { # svc_row <proxy|chat> → "✓ läuft  :4000  nimctl" or "✗ aus"
  local s="$1"
