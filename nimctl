#!/usr/bin/env python3
# generated by nimctl – shell tool for Continue in code-server, whose own terminal tool returns no output there
import json, os, subprocess, urllib.parse, urllib.request
try:
    from mcp.server.mcpserver import MCPServer as Server   # mcp >= 2
except ImportError:                                       # mcp 1.x
    from mcp.server.fastmcp import FastMCP as Server

WS_FILE = os.environ.get("NIMCTL_WORKSPACE_FILE", os.path.expanduser("~/.nimctl/ide-workspace"))
SEARCH_URL = os.environ.get("NIMCTL_SEARCH_URL", "")
MAX_LINES = 300
server = Server("shell", instructions="Runs shell commands in the project folder that is open in the IDE and returns their output.")

def workspace() -> str:
    try:
        d = open(WS_FILE).read().strip()
        if d and os.path.isdir(d):
            return d
    except OSError:
        pass
    return os.path.expanduser("~")

@server.tool()
def run(command: str, cwd: str = "", timeout: int = 900) -> str:
    """Run a bash command and return its exit code and output. cwd defaults to the project folder open in the IDE."""
    d = cwd or workspace()
    if not os.path.isdir(d):
        return f"exit=1\ncwd not found: {d}"
    try:
        p = subprocess.run(["bash", "-lc", command], cwd=d, capture_output=True, text=True, timeout=timeout)
    except subprocess.TimeoutExpired:
        return f"exit=124\ntimeout after {timeout}s: {command}"
    out = p.stdout + ("\n[stderr]\n" + p.stderr if p.stderr.strip() else "")
    lines = out.splitlines()
    if len(lines) > MAX_LINES:
        out = f"[{len(lines) - MAX_LINES} earlier lines omitted]\n" + "\n".join(lines[-MAX_LINES:])
    return f"exit={p.returncode}\ncwd={d}\n{out}"

@server.tool()
def web_search(query: str, count: int = 5) -> str:
    """Search the web through nimctl's local SearXNG and return title, URL and snippet per result."""
    if not SEARCH_URL:
        return "web search is not set up: run `nimctl search install`"
    url = f"{SEARCH_URL}/search?format=json&q={urllib.parse.quote_plus(query)}"
    try:
        with urllib.request.urlopen(url, timeout=25) as r:
            data = json.load(r)
    except Exception as e:  # noqa: BLE001 – report, do not crash the tool server
        return f"search failed ({e}); is it running? nimctl search start"
    rows = []
    for r in data.get("results", [])[: max(1, min(int(count), 20))]:
