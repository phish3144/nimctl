}
ide_open() { # ide_open [dir] – folder argument wins, then the git project in the current directory, then the stored folder
  if [[ -n "${1:-}" ]]; then ide_set_workspace "$1" || return $?
  elif [[ -d "$PWD/.git" ]]; then ide_set_workspace "$PWD" || return $?
  elif [[ -n "$(ide_workspace)" ]]; then info "$(tf ide_ws "$(ide_workspace)")"; fi
  ide_ensure || return 1; ok "$(tf ide_url "$(ide_url)")"
  open_url "$(ide_url)" || true; info "$(t ide_tools_hint)"
}
ide_disable() { # stop it, take it out of start/stop/restart and systemd; the installation and the configs stay
  if has systemctl && [[ -f "$(unit_dir)/nimctl-ide.service" ]]; then systemctl --user disable --now nimctl-ide 2>/dev/null; rm -f "$(unit_dir)/nimctl-ide.service"; systemctl --user daemon-reload 2>/dev/null; fi
  stop_svc ide; IDE_ENABLED=0; save_conf; ok "$(t ide_disabled)"
}
cmd_ide() { # cmd_ide [dir|open [dir]|start|stop|disable|password [--reset]|config [--force]|autocomplete on|off|install]
  local sub="${1:-open}"; (( $# )) && shift
  [[ "$sub" != open && -d "$sub" ]] && { set -- "$sub" "$@"; sub=open; }   # nimctl ide ~/src/project
  case "$sub" in
    install) inst_codeserver;;
    open)    ide_open "${1:-}";;
    start)   ide_ensure;;
    stop)    stop_svc ide;;
    disable) ide_disable;;
    password) if [[ "${1:-}" == --reset ]]; then IDE_PASSWORD=$(gen_secret | head -c 24); save_conf; ide_write_config >/dev/null; ok "$(t ide_pw_reset)"; fi
              [[ -n "$IDE_PASSWORD" ]] || { IDE_PASSWORD=$(gen_secret | head -c 24); save_conf; }; printf '%s\n' "$IDE_PASSWORD";;
    config)  [[ -n "$IDE_PASSWORD" ]] || { IDE_PASSWORD=$(gen_secret | head -c 24); save_conf; }; ide_write_config "${1:-}";;
    autocomplete) case "${1:-}" in on) IDE_AUTOCOMPLETE=1; save_conf; ide_write_config && warn "$(t ide_ac_on)";; off) IDE_AUTOCOMPLETE=0; save_conf; ide_write_config && ok "$(t ide_ac_off)";; *) bad "$(t invalid): ${1:-}"; return 64;; esac;;
    *) bad "$(t unknown): $sub"; return 64;;
  esac
}
dash_register v cmd_ide k_v use

