    if ! has code-server; then local b; b=$(ls -d "$HOME/.local/lib"/code-server-*/bin/code-server 2>/dev/null | tail -n1); [[ -n "$b" ]] && { mkdir -p "$HOME/.local/bin"; ln -sf "$b" "$HOME/.local/bin/code-server"; }; fi
    has code-server || { bad "$(tf inst_fail code-server)"; return 1; }
  fi
  local ext; for ext in Continue.continue ${NIMCTL_IDE_EXTENSIONS:-}; do
    printf "  %s" "$(tf ide_ext "$ext")"
    if code-server --extensions-dir "$NIM_DIR/ide-data/extensions" --user-data-dir "$NIM_DIR/ide-data" --install-extension "$ext" >>"$LOG_DIR/code-server-install.log" 2>&1; then printf "%s\n" "$OK"; else printf "%s\n" "$NO"; warn "$(tf inst_fail "$ext") → $LOG_DIR/code-server-install.log"; fi
  done
  declare -F inst_uv >/dev/null && ! has uv && inst_uv
  mkdir -p "$NIM_DIR/mcp"; ide_warm_mcp
  [[ -n "$IDE_PASSWORD" ]] || IDE_PASSWORD=$(gen_secret | head -c 24)
  IDE_ENABLED=1; save_conf; ok "$(t ide_enabled)"
}
ide_ensure() { # installed, proxy up, code-server up – and only then enabled for start/stop/restart and systemd
  has code-server || { bad "$(tf svc_missing code-server)"; info "→ nimctl ide install"; return 1; }
  svc_running proxy || { info "$(t proxy_starting)"; start_proxy || { bad "$(t ide_no_proxy)"; return 1; }; }
  mkdir -p "$NIM_DIR/mcp"; ide_warm_mcp
  svc_running ide || start_ide || return 1
