    if ! has code-server; then local b; b=$(ls -d "$HOME/.local/lib"/code-server-*/bin/code-server 2>/dev/null | tail -n1); [[ -n "$b" ]] && { mkdir -p "$HOME/.local/bin"; ln -sf "$b" "$HOME/.local/bin/code-server"; }; fi
