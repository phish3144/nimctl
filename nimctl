    printf '  - name: "fast · %s"\n    provider: openai\n    model: nim-fast\n    apiBase: %s\n    apiKey: %s\n    roles: [chat]\n    defaultCompletionOptions: { contextLength: %s, maxTokens: 4096 }\n' "$MODEL_FAST" "$base" "$MASTER_KEY" "$ctx"
    if [[ -n "$MODEL_REVIEW" ]]; then more=", review"
      printf '  - name: "review · %s"\n    provider: openai\n    model: nim-review\n    apiBase: %s\n    apiKey: %s\n    roles: [chat]\n    capabilities: [tool_use]\n    defaultCompletionOptions: { contextLength: %s, maxTokens: 8192 }\n' "$MODEL_REVIEW" "$base" "$MASTER_KEY" "$ctx"; fi
    if [[ "$IDE_AUTOCOMPLETE" == 1 ]]; then more+=", autocomplete"
      printf '  - name: "autocomplete · %s"\n    provider: openai\n    model: nim-fast\n    apiBase: %s\n    apiKey: %s\n    roles: [autocomplete]\n    useLegacyCompletionsEndpoint: false\n    autocompleteOptions: { debounceDelay: 500, maxPromptTokens: 1024, onlyMyCode: true }\n' "$MODEL_FAST" "$base" "$MASTER_KEY"; fi
    printf 'context:\n  - provider: code\n  - provider: currentFile\n  - provider: open\n  - provider: diff\n  - provider: terminal\n  - provider: problems\n  - provider: folder\n'
    local senv=""; [[ "$SEARCH_ENABLED" == 1 ]] && senv=", NIMCTL_SEARCH_URL: \"http://127.0.0.1:$SEARCH_PORT\""
    printf 'mcpServers:\n  - name: shell\n    command: %s\n    args: %s\n    env: { NIMCTL_WORKSPACE_FILE: %s%s }\n' "$(jq -n --arg s "$cmd" '$s')" "$args" "$(jq -n --arg s "$(ide_ws_file)" '$s')" "$senv"
    printf 'rules:\n  - name: nimctl shell tool\n    rule: "Run every shell command with the MCP tool run from the server shell: it executes in the project folder open in the IDE and returns the exit code and the output. Never use RunTerminalCommand in this IDE, it returns no output here. Read the exit code before deciding anything; exit=0 means success.%s"\n' "$([[ "$SEARCH_ENABLED" == 1 ]] && printf ' Use the MCP tool web_search from the same server to look things up online.')"
  } >"$f.tmp"; chmod 600 "$f.tmp"; mv "$f.tmp" "$f"
  info "$(tf ide_cfg "$f")"; info "$(tf ide_models "$more")"; info "$(tf ide_tools "$tool")"
