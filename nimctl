.chart svg { display: block; width: 100%; height: auto; overflow: visible; }
.chart .tip { position: absolute; pointer-events: none; background: var(--surface); border: 1px solid var(--border); box-shadow: var(--shadow); border-radius: 8px; padding: 6px 10px; font-size: 12px; min-width: 120px; display: none; z-index: 5; }
.chart .tip .k { display: flex; align-items: center; gap: 6px; justify-content: space-between; }
.chart .tip .k b { font-variant-numeric: tabular-nums; }
.chart .tip .key { width: 12px; height: 0; border-top: 2px solid var(--muted); }
