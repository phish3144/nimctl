.meter.warn i { background: var(--warn); } .meter.crit i { background: var(--crit); }
.bar-track { height: 6px; background: var(--grid); border-radius: 3px; overflow: hidden; min-width: 60px; }
.bar-track i { display: block; height: 100%; background: var(--s1); border-radius: 0 3px 3px 0; }
.list { max-height: 420px; overflow: auto; border: 1px solid var(--grid); border-radius: 8px; }
.list .item { display: flex; align-items: center; gap: 8px; padding: 6px 10px; border-bottom: 1px solid var(--grid); font-size: 13px; }
.list .item:last-child { border-bottom: 0; } .list .item .id { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
