  [thr_line]="Budget   %s/min · %s frei · %s wartend · %s gebremst%s" [thr_avg]=" (Ø %s s)" [thr_penalty]=" · gedrosselt nach 429 bis %s"
  [thr_rejected]=" · %s abgewiesen" [thr_cool]="Pausiert %s" [thr_cool_item]="%s (%s, bis %s)"
)
